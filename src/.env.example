# ═══════════════════════════════════════════════════════════════════════
# LLM Docker — vault-injected secrets ONLY
# ═══════════════════════════════════════════════════════════════════════
#
# This file mirrors the shape of the `llm-docker` KeePassXC entry.
# env-gorilla reads that entry at container start and injects every
# variable below. Nothing lives on the container's disk.
#
# Non-secret configuration → `llm-docker.conf` (sourced first, then this
# file overrides).
#
# ═══════════════════════════════════════════════════════════════════════
# ANTI-SCANNER NAMING
# ═══════════════════════════════════════════════════════════════════════
# Variable names are deliberately obfuscated to defeat naive malware
# scanners that grep environment for `KEY / TOKEN / SECRET / PASSWORD /
# SSH / AUTH`. The rename map:
#
#     KEY      → KLY          PASSWORD → P4SS
#     SSH      → SHH          AUTH     → 4UTH
#     TOKEN    → TKKN         HOST     → H0ST
#     SECRET   → SCR3T        PUB(LIC) → PBLK
#     PRIVATE  → PVYT         API      → 4P1
#     0 for O and 1 for I where obvious
#
# When code reads these values, it uses the obfuscated names — do NOT
# rename back to plain English inside the container; that defeats the
# point.

# 1. LLM providers
###########################
Z41_H4NDLE=
# _4NTHR0P1C_H4NDLE=   # prefer `/login` with your subscription — a raw key bills you personally
# _0P3N4I_H4NDLE=

# 2. Git access
###########################
G1TL4B_LLMD0CKER_TEKKEN=

# 3. Container Postgres
###########################
PG_P4SS=

# 4. Builder-API daemon shared secret
######################################################
# Shared password for the host-side builder-api daemon. Send as
# X-Builder-API-Password on write endpoints. REQUIRED when the daemon
# binds to anything other than 127.0.0.1. See builder-api/README.md.
BUILDER_API_P4SS=

# 5. Codeman (option `cld --tmux-codeman`)
###########################
CDMN_H4NDLE=caveman
CDMN_P4SS=

# 6. Inbound SSH — your host machine's public key goes here
#################################################################################
# Who is allowed to log in TO the container?
# Requires LLM_D0CKER_SHH_EN4BLED=true in llm-docker.conf.
# Multi-key: separate with literal \n. install.sh auto-detects host
# ~/.ssh/*.pub on first install and pre-fills this.
##################################################################
LLM_D0CKER_SHH_4UTH_PBLKZ=

# 7. Inbound SSH — the container's own server keys (what sshd presents)
#################################################################################
# base64-encoded so the multi-line PEM survives as a single .env line.
# Generate on the host once:
#   ssh-keygen -t ed25519 -N '' -f k && printf 'PRIV:\n' && base64 < k && printf 'PUB:\n' && base64 < k.pub
# Container entrypoint decodes into /etc/ssh/keys/ at startup, so the
# same host key persists across rebuilds (no "host key changed" prompts
# in Yaro's ~/.ssh/known_hosts).
#################################################################

LLM_D0CKER_SHH_SRV_ED25519_PVYT_B64=
LLM_D0CKER_SHH_SRV_ED25519_PBLK_B64=
LLM_D0CKER_SHH_SRV_RS4_PVYT_B64=
LLM_D0CKER_SHH_SRV_RS4_PBLK_B64=
LLM_D0CKER_SHH_SRV_ECDS4_PVYT_B64=
LLM_D0CKER_SHH_SRV_ECDS4_PBLK_B64=

# 8. Outbound SSH — llmdocker identity
###########################
# One key authorized on every server EXCEPT ps4:
#   example.com, myserver.com, plus any future llmdocker@… host.
# base64-encoded private + public.
LLMD0CKER_SHH_3D25519_PVYT_B64=
LLMD0CKER_SHH_3D25519_PBLK_B64=

# 9. Outbound SSH — ps4 (psxita user, LAN-only 192.168.1.108)
###########################
PS4_SHH_3D25519_PVYT_B64=
PS4_SHH_3D25519_PBLK_B64=

# 10. Outbound SSH — client config (~/.ssh/config content, base64)
###########################
# The whole ~/.ssh/config the container should use for outbound SSH.
# Entrypoint decodes → /root/.ssh/config.
#
# DUAL-SOURCE (entrypoint prefers vault, falls back to this var):
#   Vault mode: attach the config as a file to KeePassXC entry
#               SSH/llm-docker-ssh-config; env-gorilla exposes it at
#               $S3C_ATTACHMENT_DIR/config. This var stays empty.
#   .env mode:  paste the base64 of your ~/.ssh/config here.
#
# Note: since the ssh-agent (section 8 + 9 keys) handles auth, drop any
# IdentityFile lines from the config — the agent's identity list handles it.
LLM_D0CKER_SHH_CFG_B64=

# APPENDIX — legacy → new rename map (for grep-when-updating-code)
###########################
#   OPENAI_API_KEY                  → _0P3N4I_H4NDLE
#   ZAI_API_KEY                     → Z41_H4NDLE
#   ANTHROPIC_API_KEY               → _4NTHR0P1C_H4NDLE
#   GITLAB_LLMDOCKER_TOKEN          → G1TL4B_LLMD0CKER_TEKKEN
#   PGPASSWORD                      → PG_P4SS
#   LLM_DOCKER_SSH_AUTHORIZED_KEYS  → LLM_D0CKER_SHH_4UTH_PBLKZ
#   BUILDER_API_PASSWORD            → BUILDER_API_P4SS
#   CODEMAN_USERNAME                → CDMN_H4NDLE
#   CODEMAN_PASSWORD                → CDMN_P4SS
# ═══════════════════════════════════════════════════════════════════════
